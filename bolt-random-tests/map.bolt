// an unconventional map method
let map = fn(arr, f){ // Map function
    let iter = fn(a, accumulated) {
        if len(a) == 0{
            return accumulated 
        }else{
            let l = len(a);
            let rstart = 1;
            let rend = l;
            let next  = a[rstart:rend]
            return iter(next, push(accumulated,f(a[0])));
        }
    }; 
    return iter(arr, [])
}

let double = fn(item){
    return item * 2
}

log(map([1.5,2.2,3,4,5,3], double))
