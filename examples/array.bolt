import "examples/functions.bolt"

log(functions.y)

struct m {
    abs,
    another,
    jeff
}

struct a {
    bob
}

let math = new m{abs:new a{bob:fn(x){
    let another = new m{abs: 12}
    another.abs + 20
    return x
}}, another: new m{abs: new a{bob:12}}, jeff: [1,2,3]}
let ne = math
let arr = [1,2,3,4]

let insert = fn(arr, i, val){
    if i<0 || i >= len(arr){
        return "bad index"
    }
    let newArr = push(push(arr[0:i+1], val), arr[i+1:len(arr)])
    return newArr
}

math.jeff[2]
math.abs.bob(12)

log(insert(arr, 1, "bob"))
