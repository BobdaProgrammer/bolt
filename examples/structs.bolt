struct Person{
    name,
    age
}

struct Something{
    name,
    age
}

let Person.read = fn(){
    return "Name: "+Person.name+"\nAge: "+string(Person.age)
}

let bob = new Person{name: "bob", age: 20}
log(bob.read())

let jeff = new Person{name: "jeff", age: 24}
log(jeff.read())

// Converting a different struct type to person and then using it to read
let another = new Something{name: "another person", age: 43}
log(another as Person.read())
