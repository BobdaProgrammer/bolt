import "strings"
import "math"

struct File{
    name,
    path,

    // functions
    read,
    write,
    append,
    close
}

struct Filepath{}

pub let filepath = new Filepath{}


// TODO: filepath work
let Filepath.ext = fn(x){
    if typeof(x) != "STRING" && typeof(x) != "File"{
        return error("File path must be of type string or file")
    }

    let name = x
    if typeof(x) == "File"{
        name == x.name
    }

    if !strings.contains(name, "."){
        return null
    }

    // get rid of trailing / or \
    name = strings.trimRight(strings.trimRight(name, "/"), "\\")

    if name == ""||strings.endsWith(name, "."){
        return null
    }


    // TODO: handle if path is "hello/bob\this/that.txt" also "that.bob.txt"
    let slash = "/"
    if strings.contains(name, "\\") || strings.contains(name, "/"){
        let spl = name[math.max(strings.lastIndexOf(name, "/"), strings.lastIndexOf(name,"\\"))+1:len(name)]
        if strings.contains(spl, "."){
            let ext = spl[strings.indexOf(spl, "."):len(spl)]
            return ext
        }
    }else if !strings.contains(name, "/") && strings.contains(name, "."){
        let ext = name[strings.indexOf(name, "."):len(name)] 
        return ext
    }

    return null
}


pub let closeAll = fn(){
    GOSTDCALLsyscall("closeall")
}

pub let open = fn(x){
    // returns a File struct
    let f = new File{}
    let err = GOSTDCALLsyscall("open", f, x)
    if typeof(err) == "ERROR"{
        return error("Cannot open file: "+x)
    }
    f.read = fn(){
        return GOSTDCALLsyscall("read", f.path)
    }
    f.write = fn(x){
        return GOSTDCALLsyscall("write", f.path, x)
    }
    f.append = fn(x){
        return GOSTDCALLsyscall("append", f.path, x)
    }
    f.close = fn(){
        return GOSTDCALLsyscall("close", f.path)
    }
    return f
}
